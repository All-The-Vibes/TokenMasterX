+def test_min_calls_filters_sessions_including_subagent_calls(tmp_path, capsys):
+    home = make_home(tmp_path)
+    baseline = run_json(home, capsys, "session")
+    assert run_json(home, capsys, "session", "--min-calls", "1") == baseline
+    report = run_json(home, capsys, "session", "--min-calls", "3", "--breakdown")
+    assert [row["session"] for row in report["rows"]] == ["T"]
+    assert report["totals"]["calls"] == 3
+    assert report["totals"]["sessions"] == 1
+    assert report["rows"][0]["breakdown"]["gpt-6-astra"]["calls"] == 3
+    assert report["totals"]["total"] == sum(c[4] + c[5] for c in CALLS if c[0] == "T")
+    empty = run_json(home, capsys, "daily", "--min-calls", "4")
+    assert empty["rows"] == []
