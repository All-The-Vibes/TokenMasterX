+def has_exact_reuse_marker(text: object) -> bool:
+    """Recognize a complete, canonical exact-reuse marker, not its provenance."""
+    if type(text) is not str or not text.startswith(_PREFIX) or not text.endswith(_SUFFIX):
+        return False
+    try:
+        data = json.loads(text[len(_PREFIX):-len(_SUFFIX)])
+        if type(data) is not dict or data.keys() != {
+            "source_index", "target_index", "tool_name", "source_path",
+            "source_call_id", "target_call_id", "content_sha256",
+        }:
+            return False
+        return (
+            type(data["source_index"]) is int
+            and type(data["target_index"]) is int
+            and 0 <= data["source_index"] < data["target_index"]
+            and data["tool_name"] in _TOOLS
+            and all(type(data[key]) is str and data[key]
+                    for key in ("source_path", "source_call_id", "target_call_id"))
+            and type(data["content_sha256"]) is str
+            and re.fullmatch(r"[0-9a-f]{64}", data["content_sha256"]) is not None
+            and text == _marker(data)
+        )
+    except (ValueError, RecursionError):
+        return False
+
+
 def _marker_looking(text):
     # Conservatively exclude our markers, CCR references, and partial wrappers.
     return "[[" in text or "]]" in text or "EXACT_READ_REUSE" in text
