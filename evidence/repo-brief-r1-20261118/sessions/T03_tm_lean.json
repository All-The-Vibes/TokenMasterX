        "command": "$env:PYTHONDONTWRITEBYTECODE = '1'; @'\nimport sys\nfrom dataclasses import asdict\nsys.path.insert(0, r'token-master-plugin\\skills\\token-master')\nfrom brainspace.request_policy import RequestPolicy\np = RequestPolicy(enabled=True, max_input_tokens=10, max_wire_bytes=20, max_output_tokens=30)\nassert p.with_limits() == p and p.with_limits() is not p\nfor name in ('max_input_tokens', 'max_wire_bytes', 'max_output_tokens'):\n    expected = asdict(p)\n    expected[name] = 100\n    assert asdict(p.with_limits(**{name: 100})) == expected\n    assert p.with_limits(**{name: None}) == p\n    for invalid in (0, -1, True, 1.5, '10'):\n        try:\n            p.with_limits(**{name: invalid})\n        except ValueError:\n            pass\n        else:\n            raise AssertionError((name, invalid))\nassert p.with_limits(max_input_tokens=1, max_wire_bytes=2, max_output_tokens=3) == RequestPolicy(enabled=True, max_input_tokens=1, max_wire_bytes=2, max_output_tokens=3)\nassert p.max_input_tokens == 10\n'@ | python -; if ($LASTEXITCODE -eq 0) { python -m pytest -q -p no:cacheprovider token-master-plugin\\skills\\token-master\\tests\\test_request_policy.py token-master-plugin\\skills\\token-master\\tests\\test_json_request_policy.py }; if ($LASTEXITCODE -eq 0) { git --no-pager diff --check; git --no-pager status --short }",
