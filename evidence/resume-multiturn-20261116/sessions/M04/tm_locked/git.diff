+def test_limit_truncates_sorted_rows_without_changing_filtered_totals(tmp_path, capsys, report, order):
+    home = make_home(tmp_path)
+    args = (report, "--order", order, "--only", "tokenmaster")
+    full = run_json(home, capsys, *args)
+    assert len(full["rows"]) == 2
