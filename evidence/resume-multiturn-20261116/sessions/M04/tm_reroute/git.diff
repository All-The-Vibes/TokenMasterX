+@pytest.mark.parametrize("report", ["session", "daily"])
+@pytest.mark.parametrize("order", ["asc", "desc"])
+def test_limit_truncates_sorted_rows_without_changing_filtered_totals(tmp_path, capsys, report, order):
+    home = make_home(tmp_path)
+    args = (report, "--order", order, "--only", "tokenmaster")
+    full = run_json(home, capsys, *args)
+    limited = run_json(home, capsys, *args, "--limit", "1")
+    assert len(full["rows"]) == 2
+    assert limited["rows"] == full["rows"][:1]
+    assert limited["totals"] == full["totals"]
+    assert limited["totals"]["calls"] > limited["rows"][0]["calls"]
+    assert run_json(home, capsys, *args, "--limit", "99") == full
+
+
+def test_limit_preserves_table_total(tmp_path, capsys):
+    home = make_home(tmp_path)
+    args = ["session", "--ascii", "--no-color", "--full", "--copilot-home", str(home)]
+
+    def total_cells(extra):
+        assert tokenomics.main(args + extra) == 0
+        out = capsys.readouterr().out
+        line = next(line for line in out.splitlines() if "| Total " in line)
+        return [cell.strip() for cell in line.split("|")]
+
+    assert total_cells(["--limit", "1"]) == total_cells([])
+
+
+@pytest.mark.parametrize("value", ["0", "-1", "abc", "1.5"])
+def test_limit_rejects_invalid_values(capsys, value):
+    with pytest.raises(SystemExit) as error:
+        tokenomics.main(["--limit", value])
+    assert error.value.code == 2
+    assert "argument --limit: expected an integer >= 1" in capsys.readouterr().err
+
