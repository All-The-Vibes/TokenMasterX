+def test_min_calls_filters_sessions_and_totals(tmp_path, capsys, minimum, sessions, count):
+    home = make_home(tmp_path)
+    options = [] if minimum is None else ["--min-calls", str(minimum)]
+    report = run_json(home, capsys, "session", *options)
+    assert [row["session"] for row in report["rows"]] == sessions
+    assert sum(row["calls"] for row in report["rows"]) == count
+    assert report["totals"]["calls"] == count
+    assert report["totals"]["sessions"] == len(sessions)
+
+    args = Namespace(copilot_home=str(home), since=None, until=None, project=None, only=None,
+                     report="daily", breakdown=False, order="asc")
+    if minimum is not None:
+        args.min_calls = minimum
+    data = tokenomics.build(args)
+    assert {call["session"] for call in data["calls"]} == set(sessions)
+    assert len(data["calls"]) == data["total"]["calls"] == count
+    assert sum(bucket["calls"] for _, bucket, _ in data["rows"]) == count
+
+
+@pytest.mark.parametrize("filter_name", ["since", "until", "project", "only"])
+def test_min_calls_counts_after_other_filters(tmp_path, monkeypatch, filter_name):
+    home = make_home(tmp_path)
+    calls = estimated(home)
+    _, sessions = tokenomics.load_store(home / "session-store.db")
+    calls = [call for call in calls if call["session"] == "T"]
+    day = calls[0]["at"].astimezone().date()
+    args = Namespace(copilot_home=str(home), since=None, until=None, project=None, only=None,
+                     report="session", breakdown=False, order="asc", min_calls=3)
+    if filter_name in ("since", "until"):
+        setattr(args, filter_name, day)
+        calls[-1]["at"] += timedelta(days=-2 if filter_name == "since" else 2)
+    elif filter_name == "only":
+        args.only = "tokenmaster"
+        calls[-1]["launch"] = None
+    else:
+        args.project = "repo/b"
+    monkeypatch.setattr(tokenomics, "load_store", lambda store: (calls, sessions))
+    monkeypatch.setattr(tokenomics, "estimate", lambda calls, sessions, launches: None)
+    data = tokenomics.build(args)
+    assert data["calls"] == data["rows"] == []
+    assert data["total"]["calls"] == 0
+    args.min_calls = None
+    assert len(tokenomics.build(args)["calls"]) == (0 if filter_name == "project" else 2)
+
+
+@pytest.mark.parametrize("value", ["0", "-1", "1.5", "abc", ""])
+def test_min_calls_rejects_invalid_values(value, capsys):
+    with pytest.raises(ArgumentTypeError, match="integer >= 1"):
+        tokenomics.min_calls_arg(value)
+    with pytest.raises(SystemExit) as error:
+        tokenomics.main(["--min-calls", value])
+    assert error.value.code == 2
+    assert "--min-calls" in capsys.readouterr().err
+
