+def test_min_calls_filters_sessions_and_counts_subagents(tmp_path, capsys):
+    home = make_home(tmp_path)
+    baseline = run_json(home, capsys, "session")
+    assert run_json(home, capsys, "session", "--min-calls", "1") == baseline
+    report = run_json(home, capsys, "session", "--min-calls", "3")
+    assert [row["session"] for row in report["rows"]] == ["T"]
+    assert report["rows"][0]["calls"] == report["totals"]["calls"] == 3
+    for filters in ([], ["--project", "repo/b"], ["--only", "stock"]):
+        threshold = "4" if not filters else "3"
+        report = run_json(home, capsys, "session", "--min-calls", threshold, *filters)
+        assert report["rows"] == [] and report["totals"]["calls"] == 0
