+def test_has_exact_reuse_marker_requires_exact_keys_and_canonical_encoding():
+    messages, receipts = conversation((TEXT, TEXT))
+    reuse, = find_exact_reuses(messages, receipts, {5})
+    marker = reuse.marker
+    start, end = marker.index("{"), marker.rindex("}") + 1
+    data = json.loads(marker[start:end])
+    payloads = [
+        json.dumps({key: value for key, value in data.items() if key != missing},
+                   sort_keys=True, separators=(",", ":"))
+        for missing in data
+    ]
+    payloads.extend([
