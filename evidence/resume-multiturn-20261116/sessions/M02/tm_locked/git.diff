+def test_has_exact_reuse_marker_rejects_noncanonical_or_malformed_markers():
+    messages, receipts = conversation((TEXT, TEXT))
+    reuse, = find_exact_reuses(messages, receipts, {5})
+    marker = reuse.marker
+    prefix = "[[EXACT_READ_REUSE:"
+    suffix = "]] Identical content remains visible in the earlier tool result in this request."
+    payload = marker[len(prefix):-len(suffix)]
+    data = json.loads(payload)
+
+    class StringSubclass(str):
+        pass
+
+    invalid = [
+        None, 1, {}, [], b"marker", StringSubclass(marker), "",
+        " " + marker, marker + "\n", marker[:-1],
