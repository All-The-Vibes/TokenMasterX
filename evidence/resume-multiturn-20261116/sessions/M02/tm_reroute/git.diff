+def test_has_exact_reuse_marker_rejects_each_missing_field():
+    messages, receipts = conversation((TEXT, TEXT))
+    reuse, = find_exact_reuses(messages, receipts, {5})
+    prefix, payload = reuse.marker.split(":", 1)
+    payload, suffix = payload.rsplit("]]", 1)
+    data = json.loads(payload)
+    for field in data:
+        incomplete = {key: value for key, value in data.items() if key != field}
+        modified = json.dumps(incomplete, sort_keys=True, separators=(",", ":"))
+        assert has_exact_reuse_marker(prefix + ":" + modified + "]]" + suffix) is False
