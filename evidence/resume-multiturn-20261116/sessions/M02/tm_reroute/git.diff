+def test_has_exact_reuse_marker_rejects_invalid_wrappers_and_noncanonical_json():
+    messages, receipts = conversation((TEXT, TEXT))
+    reuse, = find_exact_reuses(messages, receipts, {5})
+    marker = reuse.marker
+    prefix, payload = marker.split(":", 1)
+    payload, suffix = payload.rsplit("]]", 1)
+    data = json.loads(payload)
+    for invalid in (
