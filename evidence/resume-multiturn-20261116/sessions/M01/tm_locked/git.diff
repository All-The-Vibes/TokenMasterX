+    f"{DIR}\n  \n  two.py\n  three.py",
+    f"{DIR}\n   one.py\n  two.py\n  three.py",
+    f"{DIR}\n  one.py\n\n  two.py\n  three.py",
+    f"{DIR}\n  one.py\n{DIR}\n  two.py\n  three.py",
