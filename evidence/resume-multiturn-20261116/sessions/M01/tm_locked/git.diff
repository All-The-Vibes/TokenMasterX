+@pytest.mark.parametrize("separator", ["/", "\\"])
+@pytest.mark.parametrize("ending", ["", "\n", "\n\n"])
+@pytest.mark.parametrize("notices", ["", "\n[Output truncated.]\n[Narrow the search.]"])
+def test_unfold_paths_round_trips(separator, ending, notices):
+    directory = DIR.replace("\\", separator)
+    raw = "\n".join([f"{directory}one.py", f"{directory}two.py",
+                     f"{directory}compressors{separator}three.py:4", f"relative{separator}"])
+    raw += notices + ending
+    folded = fold_paths(raw)
+    assert folded is not None
+    assert f"\n.\n  relative{separator}" in folded
+    assert unfold_paths(folded) == raw
+
+
+def test_unfold_paths_rejects_non_strings():
+    class StringSubclass(str):
+        pass
+
+    folded = f"{DIR}\n  one.py\n  two.py\n  three.py"
+    assert unfold_paths(folded) is not None
+    for value in (None, 42, False, [], {}, folded.encode(), StringSubclass(folded)):
+        assert unfold_paths(value) is None
+
+
+@pytest.mark.parametrize("text", [
