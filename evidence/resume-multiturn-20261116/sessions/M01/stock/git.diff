+@pytest.mark.parametrize("separator", ["/", "\\"])
+@pytest.mark.parametrize("trailing", ["", "\n", "\n\n"])
+@pytest.mark.parametrize("notices", ["", "\n[Output truncated.]\n[Narrow the search.]"])
+def test_unfold_paths_round_trips(separator, trailing, notices):
+    directory = DIR.replace("\\", separator)
+    raw = "\n".join([f"{directory}one.py", f"{directory}two.py",
+                     f"{directory}compressors{separator}three.py:4", f"relative{separator}"])
+    raw += notices + trailing
+    folded = fold_paths(raw)
+    assert folded is not None
+    assert f"\n.\n  relative{separator}" in folded
+    assert unfold_paths(folded) == raw
+
+
+@pytest.mark.parametrize("text", [None, 42, False, b"paths", [], {}])
+def test_unfold_paths_rejects_non_strings(text):
+    assert unfold_paths(text) is None
+
+
+def test_unfold_paths_rejects_string_subclasses():
