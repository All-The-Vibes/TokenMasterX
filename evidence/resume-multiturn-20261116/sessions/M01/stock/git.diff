+def unfold_paths(text: object) -> str | None:
+    """Reconstruct paths only from a valid, canonical folded path list."""
+    if type(text) is not str or not text:
+        return None
+    body = text.rstrip("\n")
+    entries: list[str] = []
+    notices: list[str] = []
+    current: str | None = None
+    has_child = False
+    for line in body.split("\n"):
+        if _NOTICE.match(line):
+            if not has_child:
+                return None
+            notices.append(line)
+        elif notices:
+            return None
+        elif line.startswith("  "):
+            name = line[2:]
+            if current is None or not name or name.startswith(" "):
+                return None
+            entries.append(current + name)
+            has_child = True
+        elif line == "." or line.endswith(("/", "\\")):
+            if current is not None and not has_child:
+                return None
+            current = "" if line == "." else line
+            has_child = False
+        else:
+            return None
+    if not has_child or len(entries) < 3:
+        return None
+    result = "\n".join(entries + notices) + text[len(body):]
+    return result if fold_paths(result) == text else None
+
+
