# Normalize line endings: keep LF in the repo for code that runs on POSIX too.
* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf

# Frozen research and qualification records contain byte-level hash contracts.
# Preserve their original bytes rather than normalizing evidence on checkout.
docs/research/** -text
evidence/** -text
# Frozen study task sets: each study's protocol.json and summary.json record their SHA-256.
token-master-plugin/evals/prs*_tasks.json -text
token-master-plugin/evals/prs4_tasks.json -text
