# =============================================================================
# TokenMaster — whitelist .gitignore
#
# Strategy: ignore everything at the repo root, then explicitly re-include only
# the core deliverable. Research, benchmarks, sandboxes, session history, and
# scratch all stay on disk but out of the repo. Nothing is deleted.
# =============================================================================

# 1. Ignore every entry at the repo root (leading slash = root-only, non-recursive).
/*

# 2. Re-include ONLY the core project.
!/.gitignore
!/.gitattributes
!/.claude-plugin/
!/README.md
!/CHANGELOG.md
!/LICENSE
!/token-master-plugin/

# 2a. Re-include the README hero art + its generator. The rest of assets/
#     (crops, previews, scratch renders) stays ignored: re-include the dir,
#     re-ignore its contents, then whitelist the two files we ship.
!/assets/
/assets/*
!/assets/generate_art.py
!/assets/tokenmaster-hero.svg

# 3. Scrub generated/editor cruft from inside the kept directories.
__pycache__/
*.py[cod]
*$py.class
.DS_Store
Thumbs.db
desktop.ini

# 4. Per-repo harness output (generated by /token-master in consuming repos).
.token-master/
.codegraph/
